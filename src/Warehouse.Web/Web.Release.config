<?xml version="1.0" encoding="utf-8"?>
<!-- Applied on publish (Release). See https://go.microsoft.com/fwlink/?LinkId=125889 -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>
    <!-- Production databases are created and migrated by a deployment step, never by the web app. -->
    <add key="Warehouse:ProvisionDatabase" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Warehouse:SeedDemoData" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Warehouse:ShowDemoCredentials" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    </authentication>
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
  </system.web>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>

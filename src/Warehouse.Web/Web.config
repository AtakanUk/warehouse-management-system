<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- Windows authentication against SQL Server LocalDB (installed with Visual Studio). No secrets in source control. -->
    <add name="WarehouseDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=WarehouseDB;Integrated Security=True;MultipleActiveResultSets=True;Application Name=Warehouse.Web"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Development defaults; Web.Release.config switches them off. -->
    <add key="Warehouse:ProvisionDatabase" value="true" />
    <add key="Warehouse:SeedDemoData" value="true" />
    <add key="Warehouse:ShowDemoCredentials" value="true" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="512" />
    <globalization culture="en-GB" uiCulture="en-GB" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <authentication mode="Forms">
      <forms loginUrl="~/account/login" defaultUrl="~/" name=".WMSAUTH" timeout="60" slidingExpiration="true"
             cookieless="UseCookies" cookieSameSite="Lax" requireSSL="false" protection="All" />
    </authentication>

    <!-- Every URL requires a signed-in user unless a <location> below allows anonymous access. -->
    <authorization>
      <deny users="?" />
    </authorization>

    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <sessionState mode="InProc" cookieless="UseCookies" cookieSameSite="Lax" timeout="60" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" enableViewStateMac="true">
      <namespaces>
        <add namespace="Warehouse.Core.Domain" />
        <add namespace="Warehouse.Core.Services" />
        <add namespace="Warehouse.Web.Infrastructure" />
      </namespaces>
    </pages>
  </system.web>

  <!-- Anonymous access: sign-in/registration, error pages and static assets. -->
  <location path="account">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="error">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="not-found">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="NotFound.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="favicon.svg">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="WebResource.axd">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- Web Forms emits inline scripts (__doPostBack, validator set-up) and its client-side
             validation library (WebUIValidation.js) uses eval/new Function, hence 'unsafe-inline'
             and 'unsafe-eval'. Every resource, form post and frame is still restricted to this origin. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Unknown URLs get the application's 404 page; responses the app already rendered pass through. -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/not-found" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

</configuration>
